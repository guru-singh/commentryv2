<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>@inlast5mins</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { background: #0a0a0a; color: #eee; }
    .card { background: #161616; border-radius: 20px; }
    .thumbnail { 
    width: 80px !important; 
    height: 80px !important; 
    object-fit: cover; 
    transition: all 0.2s; 
    border: 2px solid #27272a;
  }
  
  .thumbnail:hover { 
    transform: scale(1.08); 
    border-color: #10b981; 
  }
  </style>
</head>
<body class="min-h-screen p-4">

  <div class="max-w-6xl mx-auto">
    <h1 class="text-4xl font-bold text-emerald-400 text-center mb-6">@inlast5mins</h1>

    <!-- Search Bar -->
    <form action="/discover" method="POST" class="mb-8">
      <div class="flex gap-3">
        <input type="text" name="topic" 
               placeholder="Met Gala, FIFA 2026..." 
               value="<%= topic || '' %>"
               class="flex-1 bg-zinc-900 text-white px-6 py-5 rounded-3xl text-lg focus:outline-none focus:ring-2 focus:ring-emerald-400">
<!-- Yeh line replace kar do -->
<input type="hidden" name="trendingData" value='<%= JSON.stringify(trending || {}) %>'>
        <button type="submit" class="bg-emerald-500 hover:bg-emerald-600 text-black font-bold px-10 rounded-3xl text-xl">
          🔥 Search
        </button>
      </div>
    </form>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

      <!-- LEFT PANEL - Trending + Thumbnails -->
      <div class="lg:col-span-5 card p-6">
        <h2 class="text-xl font-semibold mb-4">Trending Results</h2>
        
        <% if (trending) { %>
          <% if (topic && topic.trim() !== '') { %>
            <div class="mb-6 bg-zinc-900 p-5 rounded-2xl">
              <p class="text-emerald-400 text-sm mb-2">AI SUMMARY</p>
              <p class="text-zinc-300"><%= trending.summary %></p>
            </div>
          <% } %>

          <div class="space-y-4">
            <% trending.topics.slice(0,4).forEach((item, i) => { %>
              <div class="bg-zinc-900 p-4 rounded-2xl">
                <strong><%= i+1 %>. <%= item.title %></strong>
                <small class="text-zinc-400"><%= item.content || 'No description available' %></small><br>
                <!-- Thumbnails -->
                <% if (item.images && item.images.length > 0) { %>
                  <div class="flex gap-2 mt-3 overflow-x-auto pb-2">
                    <% item.images.slice(0,item.images.length-1).forEach(img => { %>
                      <a href="<%= img %>" target="_blank">
                        <img src="<%= img %>" 
                             class="thumbnail w-16 h-16 object-cover rounded-xl border border-zinc-700"
                             alt="News Image" width="64" height="64">
                      </a>
                    <% }) %>
                  </div>
                <% } %>
<small class="text-zinc-400"><a href="<%= item.url %>" target="_blank" class="text-emerald-400 hover:underline">Read more</a></small>
                
                <small class="text-zinc-400 block mt-2">
                  <%= item.published_date ? new Date(item.published_date).toLocaleDateString('en-IN') : 'Recent' %>
                </small>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

      <!-- RIGHT PANEL - Generated Post + Image Prompt -->
      <div class="lg:col-span-7 card p-6">
        <h2 class="text-2xl font-semibold mb-4">Generated X Post</h2>
        
        <div id="postArea" class="bg-zinc-900 p-6 rounded-3xl min-h-[260px] mb-6 text-lg leading-relaxed whitespace-pre-wrap">
          <!-- Post + Image yahan aayega -->
        </div>

        <div class="flex gap-3 mb-6">
          <button onclick="generateCombinedPost()" 
                  class="flex-1 bg-orange-500 hover:bg-orange-600 text-white font-bold py-4 rounded-2xl">
            ✍️ Generate Strong X Post + Prompt
          </button>
        </div>

        <div id="promptSection" class="hidden">
          <h3 class="text-lg font-semibold mb-2">Grok Imagine Prompt</h3>
          <div class="bg-zinc-800 p-4 rounded-2xl text-sm leading-relaxed" id="imagePromptText"></div>
          <button onclick="copyImagePrompt()" 
                  class="mt-3 bg-emerald-500 hover:bg-emerald-600 text-black font-bold px-6 py-3 rounded-2xl">
            📋 Copy Image Prompt
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    let currentTrendingData = null;
    let currentTopic = "<%= topic || '' %>";
    let currentPostText = "";
    let currentImagePrompt = "";

    // Hidden input se data parse karo
    try {
      const inputEl = document.querySelector('input[name="trendingData"]');
      if (inputEl && inputEl.value && inputEl.value !== '{}') {
        currentTrendingData = JSON.parse(inputEl.value);
      }
    } catch (e) {
      console.error("Error parsing trendingData:", e);
    }

    console.log("Loaded Trending Data:", currentTrendingData); // Debug ke liye

    async function generateCombinedPost() {
      if (!currentTrendingData || !currentTrendingData.topics || currentTrendingData.topics.length === 0) {
        alert("Pehle Search button se trending results fetch karo!");
        return;
      }

      const btn = event.target;
      const originalText = btn.innerHTML;
      btn.innerHTML = "Generating...";
      btn.disabled = true;

      try {
        const res = await fetch('/generate-post', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            trendingData: currentTrendingData,
            topic: currentTopic
          })
        });

        const data = await res.json();

        if (data.success) {
          let html = `<p class="mb-4">${data.post}</p>`;
          if (data.image) {
            html += `<img src="${data.image}" class="rounded-2xl w-full mt-4" alt="Post Image">`;
          }
          document.getElementById('postArea').innerHTML = html;
          
          currentPostText = data.post;
          currentImagePrompt = data.grokImagePrompt || "";

          // Show prompt section
          if (currentImagePrompt) {
            document.getElementById('imagePromptText').innerText = currentImagePrompt;
            document.getElementById('promptSection').classList.remove('hidden');
          }
        } else {
          alert("Error generating post");
        }
      } catch (err) {
        console.error(err);
        alert("Network error. Console check karo.");
      }

      btn.innerHTML = originalText;
      btn.disabled = false;
    }

    function copyImagePrompt() {
      if (currentImagePrompt) {
        navigator.clipboard.writeText(currentImagePrompt).then(() => {
          alert("✅ Grok Image Prompt copied! Ab Grok Imagine mein paste karke image banao.");
        });
      }
    }
  </script>
</body>
</html>